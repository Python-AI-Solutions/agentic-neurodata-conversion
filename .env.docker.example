# Docker-compose overrides for container-to-container networking.
# Copy to `.env.docker` when running services in the compose network.
#
# This file is intended to be used in addition to `.env`:
# - Host processes use `.env` (localhost URLs).
# - Containers use `.env` + `.env.docker` (service-name URLs).

# Neo4j is reachable as `neo4j` from other containers
GRAPH_DB__URI=bolt://neo4j:7687

# KG service is reachable as `kg-service` from other containers (e.g., app container)
KG__SERVICE_URL=http://kg-service:8001
