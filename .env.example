# Agentic Neurodata Conversion - Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API Key (Replace to enable LLM-powered features)
# Get your key from: https://console.anthropic.com
# This default is a dummy value so `.env.example` can be copied verbatim for CI/dev.
CORE__ANTHROPIC_API_KEY=sk-ant-test-key-not-a-real-secret

# Directory Configuration (Optional - defaults provided)
PATHS__UPLOAD_DIR=./uploads
PATHS__OUTPUT_DIR=./outputs
PATHS__LOG_DIR=./logs

# Upload Limits (Optional)
PATHS__MAX_UPLOAD_SIZE_GB=10

# Server Configuration (Optional)
API__HOST=0.0.0.0
API__PORT=8000
# Comma-separated list, or "*" for any origin
API__CORS_ORIGINS=*

# Claude Code Configuration (Optional)
# Maximum output tokens for Claude responses (default: 32000, max: 200000)
CLAUDE_CODE_MAX_OUTPUT_TOKENS=200000

# ============================================================================
# Knowledge Graph + Neo4j Configuration
# ============================================================================

# Graph DB Configuration (Neo4j today; designed to be swappable later)
GRAPH_DB__BACKEND=neo4j
GRAPH_DB__URI=bolt://localhost:7687
GRAPH_DB__USER=neo4j
# Neo4j requires a non-empty password (min 8 chars). Avoid `/` since `NEO4J_AUTH` uses `neo4j/<password>`.
GRAPH_DB__PASSWORD=test-neo4j-password
GRAPH_DB__DATABASE=neo4j

# KG Client Configuration (main app → KG service over HTTP)
KG__SERVICE_URL=http://localhost:8001
KG__ENABLED=true
KG__TIMEOUT_S=5.0
KG__MAX_RETRIES=2

# KG Service (server) Configuration
KG_SERVICE__HOST=0.0.0.0
KG_SERVICE__PORT=8001
KG_SERVICE__CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ============================================================================
# Docker Compose Port Mappings (Optional)
# ============================================================================
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
KG_SERVICE_PORT=8001
FRONTEND_PORT=3000
